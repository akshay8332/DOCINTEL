# DocIntel local settings (copy to .env — never commit secrets)

# Paths
DOCINTEL_DATA_DIR=./data
DOCINTEL_ARTIFACTS_DIR=./artifacts
DOCINTEL_FUNSD_DIR=./data/funsd

# Model
DOCINTEL_MODEL_NAME=microsoft/layoutlmv3-base
DOCINTEL_CHECKPOINT_DIR=./artifacts/checkpoints

# Training defaults (override via configs/training.yaml)
DOCINTEL_DEVICE=auto
DOCINTEL_BATCH_SIZE=2
DOCINTEL_GRAD_ACCUM=4
DOCINTEL_MAX_STEPS=
DOCINTEL_NUM_EPOCHS=5
DOCINTEL_LEARNING_RATE=5e-5

# App / API (Stage 2+)
DOCINTEL_API_HOST=127.0.0.1
DOCINTEL_API_PORT=8080
DOCINTEL_DB_URL=sqlite:///./artifacts/docintel.db
DOCINTEL_CONFIDENCE_THRESHOLD=0.75
DOCINTEL_STORAGE_ROOT=./data/uploads
